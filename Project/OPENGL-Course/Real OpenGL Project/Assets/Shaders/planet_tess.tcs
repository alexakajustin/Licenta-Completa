#version 410 core

layout (vertices = 3) out;

in vec3 WorldPos_CS_in[];
in vec2 TexCoord_CS_in[];
in vec3 Normal_CS_in[];
in vec3 LocalPos_CS_in[];

out vec3 WorldPos_ES_in[];
out vec2 TexCoord_ES_in[];
out vec3 Normal_ES_in[];
out vec3 LocalPos_ES_in[];

uniform vec3 eyePosition;
uniform float tessLevel;
uniform float tessDistance;

float GetTessLevel(float distance0, float distance1)
{
    float avgDistance = (distance0 + distance1) / 2.0;
    if (avgDistance <= 20.0) return tessLevel;
    if (avgDistance >= tessDistance) return 1.0;
    return mix(tessLevel, 1.0, (avgDistance - 20.0) / (tessDistance - 20.0));
}

void main()
{
    WorldPos_ES_in[gl_InvocationID] = WorldPos_CS_in[gl_InvocationID];
    TexCoord_ES_in[gl_InvocationID] = TexCoord_CS_in[gl_InvocationID];
    Normal_ES_in[gl_InvocationID] = Normal_CS_in[gl_InvocationID];
    LocalPos_ES_in[gl_InvocationID] = LocalPos_CS_in[gl_InvocationID];

    if (gl_InvocationID == 0)
    {
        float d0 = distance(eyePosition, WorldPos_CS_in[0]);
        float d1 = distance(eyePosition, WorldPos_CS_in[1]);
        float d2 = distance(eyePosition, WorldPos_CS_in[2]);

        gl_TessLevelOuter[0] = GetTessLevel(d1, d2);
        gl_TessLevelOuter[1] = GetTessLevel(d2, d0);
        gl_TessLevelOuter[2] = GetTessLevel(d0, d1);
        gl_TessLevelInner[0] = gl_TessLevelOuter[0];
    }
}
