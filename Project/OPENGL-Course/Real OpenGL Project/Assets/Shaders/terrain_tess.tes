#version 400 core

// Tessellation Evaluation Shader
// Performance-optimized: skips expensive normal recomputation at distance
//
// KEY DESIGN DECISION: Displacement is INDEPENDENT of layer blend mode.
// Sampler arrays are unrolled with constant indices for AMD GPU compatibility.

layout(triangles, equal_spacing, ccw) in;

in vec2 TexCoord_TCS[];
in vec3 Normal_TCS[];
in vec3 FragPos_TCS[];
in vec3 TangentWorld_TCS[];
in vec3 BitangentWorld_TCS[];
in vec3 NormalWorld_TCS[];
in vec3 LocalPos_TCS[];

out vec4 vertex_color;
out vec2 TexCoord;
out vec3 Normal;
out vec3 FragPos;
out vec3 TangentWorld;
out vec3 BitangentWorld;
out vec3 NormalWorld;
out vec3 LocalPos;
out float vIsSelected;
out float vFadeFactor;

uniform mat4 projection;
uniform mat4 view;
uniform mat4 model;
uniform vec3 eyePosition;

// ========== Same texture layer uniforms as shader.frag ==========
const int MAX_TEXTURE_LAYERS = 4;

struct TextureLayerData {
	int blendMode;
	float opacity;
	float tiling;
	float heightMin;
	float heightMax;
	float slopeMin;
	float slopeMax;
	int invert;
	int hasNormalMap;
	int hasDisplacementMap;
	float displacementScale;
};

uniform int textureLayerCount;
uniform sampler2D layerDisplacementMaps[MAX_TEXTURE_LAYERS];
uniform TextureLayerData layerData[MAX_TEXTURE_LAYERS];

// Interpolation
vec2 interp2(vec2 a, vec2 b, vec2 c) {
	return gl_TessCoord.x * a + gl_TessCoord.y * b + gl_TessCoord.z * c;
}
vec3 interp3(vec3 a, vec3 b, vec3 c) {
	return gl_TessCoord.x * a + gl_TessCoord.y * b + gl_TessCoord.z * c;
}

// Sample displacement from ALL layers — NO blend mode filtering.
// Unrolled for AMD sampler compatibility.
float getDisplacement(vec2 uv) {
	float totalDisp = 0.0;

	// Layer 0
	if (textureLayerCount > 0 && layerData[0].hasDisplacementMap == 1) {
		float h = texture(layerDisplacementMaps[0], uv * layerData[0].tiling).r;
		totalDisp += h * layerData[0].displacementScale;
	}

	// Layer 1
	if (textureLayerCount > 1 && layerData[1].hasDisplacementMap == 1) {
		float h = texture(layerDisplacementMaps[1], uv * layerData[1].tiling).r;
		totalDisp += h * layerData[1].displacementScale;
	}

	// Layer 2
	if (textureLayerCount > 2 && layerData[2].hasDisplacementMap == 1) {
		float h = texture(layerDisplacementMaps[2], uv * layerData[2].tiling).r;
		totalDisp += h * layerData[2].displacementScale;
	}

	// Layer 3
	if (textureLayerCount > 3 && layerData[3].hasDisplacementMap == 1) {
		float h = texture(layerDisplacementMaps[3], uv * layerData[3].tiling).r;
		totalDisp += h * layerData[3].displacementScale;
	}

	return totalDisp;
}

void main()
{
	// Interpolate all vertex attributes
	TexCoord       = interp2(TexCoord_TCS[0],       TexCoord_TCS[1],       TexCoord_TCS[2]);
	Normal         = interp3(Normal_TCS[0],          Normal_TCS[1],         Normal_TCS[2]);
	FragPos        = interp3(FragPos_TCS[0],         FragPos_TCS[1],        FragPos_TCS[2]);
	TangentWorld   = interp3(TangentWorld_TCS[0],    TangentWorld_TCS[1],   TangentWorld_TCS[2]);
	BitangentWorld = interp3(BitangentWorld_TCS[0],  BitangentWorld_TCS[1], BitangentWorld_TCS[2]);
	NormalWorld    = interp3(NormalWorld_TCS[0],      NormalWorld_TCS[1],    NormalWorld_TCS[2]);
	LocalPos       = interp3(LocalPos_TCS[0],        LocalPos_TCS[1],       LocalPos_TCS[2]);

	vIsSelected = 0.0;
	vFadeFactor = 0.0;
	vertex_color = vec4(clamp(LocalPos, 0.0, 1.0), 1.0);

	// ========== DISPLACEMENT ==========
	// Physical vertex displacement has been disabled to allow Parallax Occlusion Mapping
	// in the fragment shader, which provides per-pixel detail without requiring high poly density.

	// ========== NORMAL RECOMPUTATION ==========
	// Since physical displacement is disabled, we no longer need to recalculate normals.
	// We simply rely on the interpolated Normal_TCS which is perfectly smooth.

	gl_Position = projection * view * vec4(FragPos, 1.0);
}
